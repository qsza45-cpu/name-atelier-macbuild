{
  "name": "name-atelier",
  "productName": "NAME ATELIER",
  "private": true,
  "version": "0.2.0",
  "description": "NAME ATELIER - 작명 아틀리에 (웹소설 캐릭터 이름 생성기, 오프라인)",
  "author": "TALEUNE",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "check:data": "node scripts/check-data.mjs",
    "test": "node tests/engine.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "dist:win": "npm run build && node scripts/check-release.mjs && electron-builder --win nsis zip --publish never && node scripts/check-release.mjs --packaged",
    "dist:mac": "npm run build && node scripts/check-release.mjs && electron-builder --mac zip dmg --publish never && node scripts/check-release.mjs --packaged",
    "test:license": "node tests/license.test.mjs",
    "test:license-e2e": "node tests/license-e2e.mjs",
    "test:keygen-e2e": "node tests/keygen-e2e.mjs",
    "build:admin": "node scripts/build-admin.mjs",
    "start:admin": "npm run build:admin && electron dist-admin/main.js",
    "dist:admin": "npm run build:admin && electron-builder --config admin-keygen/electron-builder.json --win zip --publish never",
    "test:launch": "node tests/launch-packaged.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^38.8.6",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9"
  },
  "build": {
    "appId": "com.taleune.nameatelier",
    "productName": "NAME ATELIER",
    "copyright": "© 2026 TALEUNE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!dist/**/*.map"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "ko",
      "en-US",
      "en"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon/app_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NAME ATELIER",
      "artifactName": "NAME-ATELIER-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/icon/app_icon_1024.png"
    },
    "dmg": {
      "sign": false
    }
  }
}
